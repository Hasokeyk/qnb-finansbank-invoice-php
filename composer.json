{
    "name": "qnb-finansbank-invoice/qnb-esolutions",
    "description": "QNB eSolutions e-Fatura, e-İrsaliye, e-Arşiv ve e-Defter SOAP API PHP istemci kütüphanesi",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-soap": "*",
        "ext-mbstring": "*"
    },
    "autoload": {
        "psr-4": {
            "QnbSolutions\\QnbEsolutions\\": "src/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs --standard=PSR12 src/",
        "stan": "phpstan analyse src/"
    },
    "require-dev": {
        "phpunit/phpunit": "11"
    }
}
